<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

	<localRepository>${env.WORKSPACE_TMP}/m2/repo</localRepository>
	<mirrors>
		<mirror>
			<id>maven-central-mirror</id>
			<mirrorOf>central</mirrorOf>
			<name>Local Mirror: Maven Central</name>
			<url>${env.MVN_PROXY_central_URL}</url>
		</mirror>
		<mirror>
			<id>thesis-testing-mirror</id>
			<mirrorOf>thesis-testing</mirrorOf>
			<name>Local Mirror: thesis-testing</name>
			<url>${env.MVN_PROXY_testing_URL}</url>
		</mirror>
	</mirrors>

</settings>

